# Copy to .env.local. Do not commit real credentials.
DATABASE_URL=postgresql://breakfast:breakfast_local@localhost:55432/breakfast
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# DEMO_MAP_ID works locally. Create your own JavaScript map ID for production.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Shared PostgreSQL limit on outbound Places calls (browser map loads are separate).
MAX_GOOGLE_REQUESTS_PER_DAY=500
# Optional isolated database for integration checks; never use the application DB.
TEST_DATABASE_URL=postgresql://breakfast:breakfast_local@localhost:55432/breakfast_test
