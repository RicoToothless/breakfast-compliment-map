# Copy to .env.local. Do not commit real credentials.
DATABASE_URL=postgresql://breakfast:breakfast_local@localhost:55432/breakfast
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# DEMO_MAP_ID works locally. Create your own JavaScript map ID for production.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Google sign-in: use one canonical URL, matching your OAuth redirect URI.
BETTER_AUTH_URL=http://127.0.0.1:3050
# Generate once with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional Better Auth dashboard connection; copy from your dashboard project.
BETTER_AUTH_API_KEY=
# OAuth Web application credentials, separate from the Maps/Places API keys.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Separate monthly budgets shared by every app process through PostgreSQL.
# Reset: first of the month, midnight America/Los_Angeles. Set 0 to disable.
MAX_GOOGLE_MAP_LOADS_PER_MONTH=10000
MAX_GOOGLE_PLACES_SEARCHES_PER_MONTH=5000
MAX_GOOGLE_PLACES_DETAILS_PER_MONTH=5000
# Optional isolated database for integration checks; never use the application DB.
TEST_DATABASE_URL=postgresql://breakfast:breakfast_local@localhost:55432/breakfast_test
